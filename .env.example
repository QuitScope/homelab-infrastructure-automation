# Copy to .env (git-ignored). Used by scripts/tf.sh (docker run --env-file) and scripts/ansible.sh.
# No quotes: docker --env-file takes values literally.
PROXMOX_VE_ENDPOINT=https://192.168.178.47:8006/
# Proxmox uses a self-signed certificate.
PROXMOX_VE_INSECURE=true
# HashiCorp Vault (LAN only).
VAULT_ADDR=http://192.168.178.91:8200

# Only needed once for scripts/vault-seed.sh, which stores it in Vault (homelab/proxmox); remove afterwards.
# PROXMOX_VE_API_TOKEN=terraform@pve!iac=00000000-0000-0000-0000-000000000000

# AppRole credentials, written by scripts/vault-seed.sh from the terraform/vault outputs.
TF_VAR_vault_role_id=
TF_VAR_vault_secret_id=
ANSIBLE_HASHI_VAULT_ROLE_ID=
ANSIBLE_HASHI_VAULT_SECRET_ID=
