# {{ ansible_managed }}
services:
  ara:
    image: {{ ara_image }}
    restart: unless-stopped
    ports:
      - "{{ ara_bind }}:{{ ara_port }}:8000"
    environment:
      ARA_ALLOWED_HOSTS: "['{{ ara_bind }}', 'localhost', '127.0.0.1']"
      ARA_TIME_ZONE: {{ ara_time_zone }}
    volumes:
      # SQLite database and the generated settings.yaml (incl. secret key).
      - ara-data:/opt/ara
    mem_limit: 384m

volumes:
  ara-data:
